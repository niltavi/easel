# Server settings. Copy to .env and fill in what you need.
PORT=8787
EASEL_DB=data/easel.db

# Self-hosted mode: people register and sign in with an email and a password, and no email is sent.
# Leave it off for a public service, where sign-in requires a code emailed to the address.
# EASEL_SELF_HOSTED=1

# Sign-in code email (not used in self-hosted mode). If unset, the code is printed in the server log (local development only).
# EASEL_SMTP_URL=smtps://user:pass@smtp.example.com:465
# EASEL_MAIL_FROM=Easel <no-reply@example.com>

# AI diagram edits. AI is unavailable without ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=
# EASEL_AI_MODEL=claude-opus-5-5
# EASEL_AI_EFFORT=low
EASEL_AI_DAILY_QUOTA=5
# Local demo: return a fixed sample edit without calling the model.
# EASEL_AI_MOCK=1
