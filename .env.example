# Server settings. Copy to .env and fill in what you need.
PORT=8787
EASEL_DB=data/easel.db

# Niltavi Identity (OIDC). When configured, sign-in goes through Identity. Register the application
# with Identity first, then fill in the credentials. EASEL_ORIGIN must be the public URL of this server.
# IDENTITY_ISSUER=https://identity.niltavi.com
# IDENTITY_APP_ID=
# IDENTITY_APP_SECRET=
# EASEL_ORIGIN=https://easel.example.com

# Self-hosted mode (without Identity): email and password, no email is sent. Not used when Identity is configured.
# EASEL_SELF_HOSTED=1

# Sign-in code email (without Identity or self-hosted mode). If unset, the code is printed in the server log.
# EASEL_SMTP_URL=smtps://user:pass@smtp.example.com:465
# EASEL_MAIL_FROM=Easel <no-reply@example.com>

# AI diagram edits. AI is unavailable without ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=
# EASEL_AI_MODEL=claude-opus-5-5
# EASEL_AI_EFFORT=low
EASEL_AI_DAILY_QUOTA=5
# Local demo: return a fixed sample edit without calling the model.
# EASEL_AI_MOCK=1
