{
  "name": "niltavi-easel",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "server": "node --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=build/server.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "postinstall": "node scripts/copy-fonts.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@gravity-ui/icons": "2.23.1",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "idb": "^8.0.4",
    "nodemailer": "^10.6.0",
    "react": "19.2.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
